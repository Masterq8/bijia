    <delete id="deleteCollectionInfoById" parameterType="Long">
        delete from collection_info where id = #{id}
    </delete>

    <delete id="deleteCollectionInfoByIds" parameterType="String">
        delete from collection_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
