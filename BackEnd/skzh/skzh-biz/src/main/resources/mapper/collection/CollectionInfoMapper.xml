    <update id="updateCollectionInfo" parameterType="CollectionInfo">
        update collection_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="image != null">image =
                #{image},
            </if>
            <if test="region != null">region =
                #{region},
            </if>
            <if test="extent != null">extent =
                #{extent},
            </if>
            <if test="startTime != null">start_time =
                #{startTime},
            </if>
            <if test="endTime != null">end_time =
                #{endTime},
            </if>
            <if test="collectTime != null">collect_time =
                #{collectTime},
            </if>
            <if test="satelliteType != null">satellite_type =
                #{satelliteType},
            </if>
            <if test="sensorType != null">sensor_type =
                #{sensorType},
            </if>
            <if test="receivingId != null">
                receiving_id = #{receivingId}
            </if>
            <if test="viewPath != null">
                view_path = #{viewPath}
            </if>
            <if test="viewRow != null">
