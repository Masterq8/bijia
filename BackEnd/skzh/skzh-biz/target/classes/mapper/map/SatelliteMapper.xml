    <select id="selectSatelliteList1" parameterType="Satellite" resultMap="SatelliteResult">
        <include refid="selectSatelliteVo"/>
        <where>
            <if test="province != null and province != ''">
                and province = #{province}
            </if>
            <if test="city!= null and city != ''">
                and city = #{city}
            </if>
            <!-- 根据卫星类型信息进行过滤 -->
            <if test="satelliteTypes != null and satelliteTypes.size() > 0">
                AND satellite_type IN
                <foreach item="type" index="index" collection="satelliteTypes" open="(" separator="," close=")">
                    #{type}
                </foreach>
            </if>
            <!-- 添加日期范围过滤 -->
            <if test="startCollectTime != null">
                AND collect_time >= #{startCollectTime}
            </if>
            <if test="endCollectTime != null">
                AND collect_time &lt;= #{endCollectTime}
            </if>
        </where>
        order by collect_time desc, create_time desc
    </select>

    <update id="updateCenterPoint">
        update satellite set centerlatitude = #{centerLat}, centerlongitude = #{centerLng} where id = #{id}
    </update>
