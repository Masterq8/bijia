    <sql id="selectSatelliteVo">
        select id, region, view_path, view_row, star_path, star_row, leftup_longitude, leftup_latitude, leftdown_longitude,
           leftdown_latitude, rightup_longitude, rightup_latitude, rightdown_longitude, rightdown_latitude, sensor_type,
           satellite_type, image, collect_time, create_by, create_time, update_by, update_time, province, city,
           starttime, endtime, acquisitiontime, receivedtime, centerlatitude, centerlongitude, orbitid, sourcefilepath,
           sourcefilename, resolution, title, ex_info
        from satellite
    </sql>

    <select id="selectSatelliteList" parameterType="Satellite" resultMap="SatelliteResult">
        <include refid="selectSatelliteVo"/>
        <where>
            <if test="id != null ">
                and id = #{id}
            </if>
            <if test="region != null  and region != ''">
                and region = #{region}
            </if>
            <if test="viewPath != null ">
                and view_path = #{viewPath}
            </if>
            <if test="viewRow != null ">
                and view_row = #{viewRow}
            </if>
            <if test="starPath != null ">
                and star_path = #{starPath}
            </if>
            <if test="starRow != null ">
                and star_row = #{starRow}
            </if>
            <if test="leftupLongitude != null ">
                and leftup_longitude = #{leftupLongitude}
            </if>
            <if test="leftupLatitude != null ">
                and leftup_latitude = #{leftupLatitude}
            </if>
            <if test="leftdownLongitude != null ">
                and leftdown_longitude = #{leftdownLongitude}
            </if>
            <if test="leftdownLatitude != null ">
                and leftdown_latitude = #{leftdownLatitude}
            </if>
            <if test="rightupLongitude != null ">
                and rightup_longitude = #{rightupLongitude}
            </if>
            <if test="rightupLatitude != null ">
                and rightup_latitude = #{rightupLatitude}
            </if>
            <if test="rightdownLongitude != null ">
                and rightdown_longitude = #{rightdownLongitude}
            </if>
            <if test="rightdownLatitude != null ">
                and rightdown_latitude = #{rightdownLatitude}
            </if>
            <if test="sensorType != null  and sensorType != ''">
                and sensor_type like concat('%', #{sensorType},'%')
            </if>
            <if test="satelliteType != null  and satelliteType != ''">
                and satellite_type = #{satelliteType}
            </if>
            <if test="image != null  and image != ''">
                and image = #{image}
            </if>
            <if test="collectTime != null ">
                and collect_time = #{collectTime}
            </if>
            <if test="province != null and province != ''">
                 and province like concat('%', #{province}, '%')
            </if>
            <if test="city!= null and city != ''">
                and city like concat('%', #{city}, '%')
            </if>
        </where>
        order by collect_time desc, create_time desc
    </select>

    <select id="selectSatelliteById" parameterType="Long"
        resultMap="SatelliteResult">
        <include refid="selectSatelliteVo"/>
        where id = #{id}
    </select>

